<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/LibraryListItemCard">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clMember"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_100sdp"
        android:padding="@dimen/_12sdp">

        <!-- Dummy Member Icon -->

        <ImageView
            android:id="@+id/ivMemberIcon"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_75sdp"
            android:background="#EAF9F4"
            android:contentDescription="Member"
            android:padding="@dimen/_14sdp"
            android:src="@drawable/iv_member"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/success" />

        <ImageView
            android:id="@+id/ivDeleteMember"
            style="@style/LibraryDeleteIcon"
            android:contentDescription="Delete book"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Member Name -->

        <TextView
            android:id="@+id/tvMemberName"
            style="@style/LibraryItemTitle"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:text="John Smith"
            app:layout_constraintEnd_toStartOf="@id/ivDeleteMember"
            app:layout_constraintStart_toEndOf="@id/ivMemberIcon"
            app:layout_constraintTop_toTopOf="@id/ivMemberIcon" />

        <!-- Member Email -->

        <TextView
            android:id="@+id/tvMemberEmail"
            style="@style/LibraryItemSecondaryText"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="john@email.com"
            app:layout_constraintEnd_toEndOf="@id/tvMemberName"
            app:layout_constraintStart_toStartOf="@id/tvMemberName"
            app:layout_constraintTop_toBottomOf="@id/tvMemberName" />

        <!-- Borrowed Books Count -->

        <TextView
            android:id="@+id/tvPhone"
            style="@style/LibraryItemSecondaryText"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="1234567"
            app:layout_constraintEnd_toEndOf="@id/tvMemberName"
            app:layout_constraintStart_toStartOf="@id/tvMemberName"
            app:layout_constraintTop_toBottomOf="@id/tvMemberEmail" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>