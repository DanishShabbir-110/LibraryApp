<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/LibraryListItemCard">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_12sdp">

        <!-- Dummy Book Icon -->

        <ImageView
            android:id="@+id/ivBook"
            android:layout_width="@dimen/_72sdp"
            android:layout_height="@dimen/_100sdp"
            android:background="#E8EEFF"
            android:contentDescription="Book"
            android:padding="@dimen/_18sdp"
            android:src="@drawable/iv_books"
            app:tint="@color/primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Book Title -->

        <TextView
            android:id="@+id/tvBookTitle"
            style="@style/LibraryItemTitle"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:text="Clean Code"
            app:layout_constraintEnd_toStartOf="@id/tvStatus"
            app:layout_constraintStart_toEndOf="@id/ivBook"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Status -->

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_36sdp"
            android:gravity="center"
            android:minWidth="@dimen/_88sdp"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:text="Returned"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            android:textColor="@color/success"
            android:background="#E8F7F1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Member Name -->

        <TextView
            android:id="@+id/tvMemberName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="Ali Raza"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_15ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivBook"
            app:layout_constraintTop_toBottomOf="@id/tvBookTitle" />

        <!-- Issue Date -->

        <TextView
            android:id="@+id/tvIssueDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="Issued: 15 Aug 2025"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivBook"
            app:layout_constraintTop_toBottomOf="@id/tvMemberName" />

        <!-- Return Date -->

        <TextView
            android:id="@+id/tvReturnDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="Return: 22 Aug 2025"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivBook"
            app:layout_constraintTop_toBottomOf="@id/tvIssueDate" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>