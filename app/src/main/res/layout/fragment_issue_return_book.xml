<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".presentation.issuereturn.IssueReturnBookFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/_24sdp">

        <include
            android:id="@+id/formHeader"
            layout="@layout/header_component"
            android:layout_width="0dp"
            android:layout_height="@dimen/_64sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            app:checkedButton="@id/btnIssueMode"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/formHeader"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIssueMode"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/_50sdp"
                android:layout_weight="1"
                android:text="Issue Book"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReturnMode"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/_50sdp"
                android:layout_weight="1"
                android:text="Return Book"
                android:textStyle="bold" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/tvSelectMember"
            style="LibrarySectionLabel"
            android:text="Select Member"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toggleAction" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMember"
            style="@style/LibraryDropdownInputLayout"
            android:hint="@string/choose_member"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSelectMember"
            app:startIconDrawable="@drawable/iv_member">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actMember"
                style="@style/LibraryAutoCompleteTextView" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvSelectBook"
            style="@style/LibrarySectionLabel"
            android:text="Select Book"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilMember" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBook"
            style="@style/LibraryDropdownInputLayout"
            android:hint="Choose book"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSelectBook"
            app:startIconDrawable="@drawable/ic_books_category">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actBook"
                style="@style/LibraryAutoCompleteTextView" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvIssueDateLabel"
            style="@style/LibrarySectionLabel"
            android:text="Issue Date"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilBook" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilIssueDate"
            style="@style/LibraryCalendarInputLayout"
            android:hint="Select issue date"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvIssueDateLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIssueDate"
                style="@style/LibraryCalendarEditText"/>

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvReturnDateLabel"
            style="@style/LibrarySectionLabel"
            android:text="Return Date"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilIssueDate" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilReturnDate"
            style="@style/LibraryCalendarInputLayout"
            android:hint="Select return date"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvReturnDateLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReturnDate"
                style="@style/LibraryCalendarEditText" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            style="@style/LibraryPrimaryButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilReturnDate" />

        <include
            android:id="@+id/loadingOverlay"
            layout="@layout/loading_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>