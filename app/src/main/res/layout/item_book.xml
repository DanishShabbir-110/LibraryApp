<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <ImageView
            android:id="@+id/ivBookIcon"
            android:layout_width="72dp"
            android:layout_height="100dp"
            android:background="#E8EEFF"
            android:contentDescription="Book"
            android:padding="14dp"
            android:src="@drawable/iv_books"
            app:layout_constraintBottom_toBottomOf="@id/tvBookAvailability"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvBookTitle"
            app:tint="@color/primary" />

        <!-- Delete Icon -->

        <ImageView
            android:id="@+id/ivDeleteBook"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:contentDescription="Delete book"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/iv_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/error" />

        <TextView
            android:id="@+id/tvBookTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:text="Clean Code"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/ivDeleteBook"
            app:layout_constraintStart_toEndOf="@id/ivBookIcon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvBookAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Robert C. Martin"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="@id/tvBookTitle"
            app:layout_constraintStart_toStartOf="@id/tvBookTitle"
            app:layout_constraintTop_toBottomOf="@id/tvBookTitle" />

        <TextView
            android:id="@+id/tvBookCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Programming"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="@id/tvBookTitle"
            app:layout_constraintStart_toStartOf="@id/tvBookTitle"
            app:layout_constraintTop_toBottomOf="@id/tvBookAuthor" />

        <TextView
            android:id="@+id/tvBookAvailability"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Available: 3 / 5"
            android:textColor="@color/success"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/tvBookTitle"
            app:layout_constraintStart_toStartOf="@id/tvBookTitle"
            app:layout_constraintTop_toBottomOf="@id/tvBookCategory" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>